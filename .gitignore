# LaTeX 的 *.out 仅限报告目录，避免吞掉课程作业的结果文件
DL/*/report/*.out
ML/*/report/*.out
河川/*/*.out

# Python 编译产物
__pycache__/
*.pyc

# 工具缓存
.pytest_cache/
.ruff_cache/

# 打包产物
build/
dist/
*.egg-info/

# 就地虚拟环境（uv 等工具创建）
.venv/

# Jupyter
.ipynb_checkpoints/

# Java 编译产物
*.class
out/

# 例外：保留课程给定的参考输出（必须置于 *.class 之后方能生效）
!Java/hw6/example_output/**

# 敏感信息（密钥、凭据类一律忽略；需保留模板文件时用 ! 例外）
.env
.env.*
*.pem
# *.key 与 Keynote 文稿后缀相撞时，按 §4 用 ! 例外保留
*.key
id_rsa*
id_ed25519*
.credentials.json
auth.json
credentials.json

# 系统文件
.DS_Store
._*
Thumbs.db

